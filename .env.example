# Database. Defaults to a local SQLite file when unset, so the API runs with
# no configuration at all. Point it at MySQL for anything real.
DATABASE_URL=mysql+aiomysql://storefront:storefront@localhost:3306/storefront_admin
# DATABASE_URL=sqlite+aiosqlite:///./storefront_admin.db

# Echo every statement to the log. Useful locally, noisy everywhere else.
SQL_ECHO=false

# When set, every POST/PATCH/DELETE must send this value in an X-API-Key
# header. Leave unset only for local development.
ADMIN_API_KEY=

# Listing limits.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# A product is "low stock" below this quantity.
LOW_STOCK_THRESHOLD=10

# Who writes GET /insights: "rules" (default, deterministic, offline) or
# "anthropic". The Anthropic provider needs `pip install -r requirements-ai.txt`
# and falls back to "rules" whenever it cannot answer.
INSIGHT_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
